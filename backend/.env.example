# Puerto del API (por defecto 8080)
PORT=8080
# Escuchar en todas las interfaces (necesario para probar el API desde el móvil por IP LAN). Opcional: HOST=127.0.0.1 solo local
HOST=0.0.0.0
# Secreto para firmar JWT (cambiar en producción)
JWT_SECRET=your-super-secret-key-change-in-production
# Conexión a Supabase (PostgreSQL). En Supabase: Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# AWS S3 (subida de archivos con presigned URL). Ver docs/s3-presigned-uploads.md
# Debe coincidir con la región real del bucket (consulta en S3 > bucket > Propiedades).
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Google OAuth: client ID con el que se firman los ID tokens del frontend (Web).
# Debe coincidir EXACTAMENTE con GOOGLE_CLIENT_ID del frontend, porque se usa
# como `audience` al verificar el ID token contra Google.
GOOGLE_CLIENT_ID=your-google-client-id

# Microservicio fileingest (Go, local :8090 o Railway/Render en producción)
FILEINGEST_BASE_URL=http://localhost:8090
FILEINGEST_INTERNAL_TOKEN=
# Token que fileingest envía al webhook POST /internal/resources/ingested
FILEINGEST_WEBHOOK_TOKEN=

# WhatsApp Business Cloud API (Meta). Phone Number ID por defecto: Mitsyy bot.
# IMPORTANTE: nunca compartas WHATSAPP_ACCESS_TOKEN en chat/código. Si se expone, revócalo
# en Meta Developers > WhatsApp > API Setup y genera uno nuevo (ideal: token permanente).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1079929778544374
WHATSAPP_WABA_ID=1300877565588715
WHATSAPP_API_VERSION=v25.0
# Token que defines tú y pegas en Meta > Webhook > Token de verificación
WHATSAPP_VERIFY_TOKEN=mitsyy_wh_verify_cambiar_en_produccion
# Plantilla de bienvenida (cuenta de prueba Meta usa hello_world). Dejar vacío para texto libre.
WHATSAPP_WELCOME_TEMPLATE=hello_world
WHATSAPP_WELCOME_TEMPLATE_LANG=en_US
# OpenAI para respuestas automáticas del bot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# WhatsApp IA — arquitectura supervisor (2026)
WHATSAPP_CONFIDENCE_THRESHOLD=0.55
WHATSAPP_SUPERVISOR_ROLLOUT_PERCENT=100
WHATSAPP_FAST_MODEL=gpt-4o-mini
WHATSAPP_CAPABLE_MODEL=gpt-4o-mini
WHATSAPP_DEFAULT_TIMEZONE=America/Lima
WHATSAPP_HISTORY_TURN_THRESHOLD=20
WHATSAPP_CONTEXT_WINDOW_TURNS=6
WHATSAPP_TRACE_PROVIDER=none
# Redis + BullMQ para recordatorios proactivos (opcional)
REDIS_URL=
WHATSAPP_ENABLE_REMINDER_WORKER=false
# LangSmith (opcional): LANGCHAIN_TRACING_V2=true LANGCHAIN_API_KEY=...
# Webhook URL pública para Meta (ejemplo): https://tu-api.com/whatsapp/webhook
# En local usa ngrok: ngrok http 8080  →  https://xxxx.ngrok-free.app/whatsapp/webhook
